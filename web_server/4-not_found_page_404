#!/usr/bin/env bash
# Installs Nginx with a 301 redirect for /redirect_me and a custom 404 page
apt-get -y update
apt-get -y install nginx
echo "Holberton School for the win!" > /var/www/html/index.html
echo "Ceci n'est pas une page" > /var/www/html/404.html

CONFIG="/etc/nginx/sites-available/default"
if ! grep -q "redirect_me" "$CONFIG"; then
    sed -i '/server_name _;/a \\n\tlocation /redirect_me {\n\t\treturn 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n\t}' "$CONFIG"
fi
if ! grep -q "error_page 404" "$CONFIG"; then
    sed -i '/server_name _;/a \\n\terror_page 404 /404.html;\n\tlocation = /404.html {\n\t\troot /var/www/html;\n\t\tinternal;\n\t}' "$CONFIG"
fi
service nginx restart
