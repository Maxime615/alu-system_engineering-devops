#!/usr/bin/env bash
# Installs Nginx and makes /redirect_me return a 301 Moved Permanently redirect
apt-get -y update
apt-get -y install nginx
echo "Holberton School for the win!" > /var/www/html/index.html

CONFIG="/etc/nginx/sites-available/default"
if ! grep -q "redirect_me" "$CONFIG"; then
    sed -i '/server_name _;/a \\n\tlocation /redirect_me {\n\t\treturn 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n\t}' "$CONFIG"
fi
service nginx restart
